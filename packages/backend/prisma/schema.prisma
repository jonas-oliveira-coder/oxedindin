generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?
  name          String
  avatarUrl     String?
  emailVerified Boolean   @default(false)
  twoFactorEnabled Boolean @default(false)
  settings      Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts         BankAccount[]
  cards            CreditCard[]
  transactions     Transaction[]
  installmentPlans InstallmentPlan[]
  recurringBills   RecurringBill[]
  bills            Bill[]
  debts            Debt[]
  owedDebts        Debt[]       @relation("OwedDebts")
  categories       Category[]
  people           Person[]
  sharedDebtsAsDebtor  SharedDebt[] @relation("DebtorSharedDebts")
  sharedDebtsAsCreditor SharedDebt[] @relation("CreditorSharedDebts")
  notifications    Notification[]
  notificationPrefs NotificationPreferences?
  passkeys         Passkey[]
  sessions         Session[]
  auditLogs        AuditLog[]

  @@index([email])
}

model BankAccount {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  institution     String
  type            AccountType
  number          String?
  agency          String?
  balanceCents    BigInt   @default(0)
  initialBalanceCents BigInt @default(0)
  status          AccountStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  notes           String?

  cards           CreditCard[]
  transactions    Transaction[]
  recurringBills  RecurringBill[]
  bills           Bill[]

  @@index([userId])
  @@index([userId, status])
}

model CreditCard {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String?
  account         BankAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  name            String
  institution     String
  brand           CardBrand
  last4           String
  limitCents      BigInt
  availableLimitCents BigInt
  closingDay      Int
  dueDay          Int
  status          CardStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  notes           String?

  invoices        Invoice[]
  transactions    Transaction[]
  installmentPlans InstallmentPlan[]
  recurringBills  RecurringBill[]
  bills           Bill[]

  @@index([userId])
  @@index([userId, status])
  @@index([accountId])
}

model Invoice {
  id              String       @id @default(cuid())
  cardId          String
  card            CreditCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  closingDate     DateTime
  dueDate         DateTime
  totalCents      BigInt       @default(0)
  paidCents       BigInt       @default(0)
  remainingCents  BigInt       @default(0)
  status          InvoiceStatus @default(OPEN)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  transactions    Transaction[]
  installments    Installment[]

  @@index([cardId])
  @@index([cardId, status])
  @@index([dueDate])
  @@unique([cardId, periodStart, periodEnd])
}

model Category {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  icon        String?
  color       String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  transactions Transaction[]
  installmentPlans InstallmentPlan[]
  recurringBills RecurringBill[]
  bills       Bill[]

  @@index([userId])
  @@unique([userId, name])
}

model Transaction {
  id                String           @id @default(cuid())
  userId            String
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String?
  account           BankAccount?     @relation(fields: [accountId], references: [id], onDelete: SetNull)
  cardId            String?
  card              CreditCard?      @relation(fields: [cardId], references: [id], onDelete: SetNull)
  installmentPlanId String?
  installmentPlan   InstallmentPlan? @relation(fields: [installmentPlanId], references: [id], onDelete: SetNull)
  invoiceId         String?
  invoice           Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  description       String
  amountCents       BigInt
  type              TransactionType
  categoryId        String?
  category          Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  date              DateTime
  paymentMethod     PaymentMethod
  notes             String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([userId])
  @@index([userId, date])
  @@index([accountId])
  @@index([cardId])
  @@index([installmentPlanId])
  @@index([invoiceId])
  @@index([categoryId])
}

model InstallmentPlan {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardId            String
  card              CreditCard   @relation(fields: [cardId], references: [id], onDelete: Cascade)
  description       String
  totalAmountCents  BigInt
  installmentsCount Int
  installmentValueCents BigInt
  startDate         DateTime
  firstInvoiceDate  DateTime
  categoryId        String?
  category          Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  installments      Installment[]
  transactions      Transaction[]

  @@index([userId])
  @@index([cardId])
  @@index([userId, startDate])
}

model Installment {
  id          String           @id @default(cuid())
  planId      String
  plan        InstallmentPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  invoiceId   String?
  invoice     Invoice?         @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  number      Int
  amountCents BigInt
  dueDate     DateTime
  status      InstallmentStatus @default(PENDING)
  paidAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([planId])
  @@index([invoiceId])
  @@index([dueDate])
  @@index([status])
  @@unique([planId, number])
}

model RecurringBill {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId   String?
  account     BankAccount?      @relation(fields: [accountId], references: [id], onDelete: SetNull)
  cardId      String?
  card        CreditCard?       @relation(fields: [cardId], references: [id], onDelete: SetNull)
  description String
  amountCents BigInt
  categoryId  String?
  category    Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  frequency   RecurringFrequency
  dueDay      Int
  startDate   DateTime
  endDate     DateTime?
  status      RecurringStatus   @default(ACTIVE)
  nextDueDate DateTime
  dateType    DateType          @default(FIXED)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  bills       Bill[]

  @@index([userId])
  @@index([userId, status])
  @@index([nextDueDate])
}

model Bill {
  id              String       @id @default(cuid())
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String?
  account         BankAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  cardId          String?
  card            CreditCard?  @relation(fields: [cardId], references: [id], onDelete: SetNull)
  recurringBillId String?
  recurringBill   RecurringBill? @relation(fields: [recurringBillId], references: [id], onDelete: SetNull)
  description     String
  amountCents     BigInt
  categoryId      String?
  category        Category?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  dueDate         DateTime
  paymentMethod   PaymentMethod?
  status          BillStatus   @default(PENDING)
  paidAt          DateTime?
  notes           String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([userId])
  @@index([userId, status])
  @@index([dueDate])
  @@index([recurringBillId])
  @@index([cardId])
}

model Debt {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  description     String
  totalAmountCents BigInt
  paidAmountCents BigInt   @default(0)
  remainingAmountCents BigInt @default(0)
  dueDate         DateTime
  type            DebtType
  relatedPersonId String?
  relatedPerson   Person?  @relation("OwedDebts", fields: [relatedPersonId], references: [id], onDelete: SetNull)
  creditorId      String?
  creditor        User?    @relation("OwedDebts", fields: [creditorId], references: [id], onDelete: SetNull)
  notes           String?
  status          DebtStatus @default(ACTIVE)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sharedDebts     SharedDebt[]

  @@index([userId])
  @@index([userId, status])
  @@index([dueDate])
  @@index([relatedPersonId])
  @@index([creditorId])
}

model Person {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  email       String?
  type        PersonType @default(INDIVIDUAL)
  phone       String?
  document    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  debts       Debt[]   @relation("OwedDebts")
  sharedDebts SharedDebt[]

  @@index([userId])
  @@index([userId, email])
  @@unique([userId, email])
}

model SharedDebt {
  id              String            @id @default(cuid())
  debtId          String
  debt            Debt              @relation(fields: [debtId], references: [id], onDelete: Cascade)
  debtorUserId    String
  debtor          User              @relation("DebtorSharedDebts", fields: [debtorUserId], references: [id], onDelete: Cascade)
  creditorUserId  String
  creditor        User              @relation("CreditorSharedDebts", fields: [creditorUserId], references: [id], onDelete: Cascade)
  personId        String?
  person          Person?           @relation(fields: [personId], references: [id], onDelete: SetNull)
  status          SharedDebtStatus  @default(PENDING)
  notifiedAt      DateTime?
  acceptedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([debtId])
  @@index([debtorUserId])
  @@index([creditorUserId])
  @@index([personId])
  @@index([status])
  @@unique([debtId, debtorUserId])
}

model Notification {
  id                  String            @id @default(cuid())
  userId              String
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  type                NotificationType
  title               String
  message             String
  read                Boolean           @default(false)
  relatedEntityType   String?
  relatedEntityId     String?
  channels            NotificationChannel[]
  createdAt           DateTime          @default(now())

  @@index([userId])
  @@index([userId, read])
  @@index([createdAt])
}

model NotificationPreferences {
  userId              String   @id
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  invoiceDueSoon      Boolean  @default(true)
  invoiceOverdue      Boolean  @default(true)
  billDueSoon         Boolean  @default(true)
  billOverdue         Boolean  @default(true)
  installmentDueSoon  Boolean  @default(true)
  debtDueSoon         Boolean  @default(true)
  sharedDebtAdded     Boolean  @default(true)
  sharedDebtUpdated   Boolean  @default(true)
  paymentReceived     Boolean  @default(true)
  securityAlert       Boolean  @default(true)
  emailEnabled        Boolean  @default(false)
  pushEnabled         Boolean  @default(false)
  inAppEnabled        Boolean  @default(true)
  updatedAt           DateTime @updatedAt
}

model Passkey {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId    String   @unique
  publicKey       String
  counter         BigInt   @default(0)
  name            String
  createdAt       DateTime @default(now())
  lastUsedAt      DateTime?

  @@index([userId])
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  ip          String?
  userAgent   String?
  deviceName  String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  entityType  String
  entityId    String
  oldData     Json?
  newData     Json?
  ip          String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum AccountType {
  CHECKING
  SAVINGS
  DIGITAL
  SALARY
  OTHER
}

enum AccountStatus {
  ACTIVE
  INACTIVE
}

enum CardBrand {
  VISA
  MASTERCARD
  AMEX
  ELO
  HIPERCARD
  OTHER
}

enum CardStatus {
  ACTIVE
  INACTIVE
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  PARTIALLY_PAID
  OVERDUE
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
}

enum PaymentMethod {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  PIX
  BANK_TRANSFER
  BOLETO
  OTHER
}

enum InstallmentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum RecurringFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

enum RecurringStatus {
  ACTIVE
  INACTIVE
  ENDED
}

enum BillStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum DebtType {
  PERSONAL_LOAN
  CREDIT_CARD
  PURCHASE
  BORROWED_MONEY
  OTHER
}

enum DebtStatus {
  ACTIVE
  PAID
  OVERDUE
  CANCELLED
  RENEGOTIATED
}

enum SharedDebtStatus {
  PENDING
  ACCEPTED
  REJECTED
  PAID
  CANCELLED
  DISPUTED
}

enum PersonType {
  INDIVIDUAL
  COMPANY
}

enum NotificationType {
  INVOICE_DUE_SOON
  INVOICE_OVERDUE
  BILL_DUE_SOON
  BILL_OVERDUE
  INSTALLMENT_DUE_SOON
  DEBT_DUE_SOON
  SHARED_DEBT_ADDED
  SHARED_DEBT_UPDATED
  PAYMENT_RECEIVED
  SHARED_DEBT_PAYMENT
  SECURITY_ALERT
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum DateType {
  FIXED
  ADJUSTABLE
}