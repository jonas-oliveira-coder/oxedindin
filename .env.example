# OxeDinDin - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Application
# ===========================================
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ===========================================
# Database (PostgreSQL)
# ===========================================
DATABASE_URL="postgresql://oxedindin:oxedindin@localhost:5432/oxedindin?schema=public"

# ===========================================
# Redis (for BullMQ queues, WebSocket, caching)
# ===========================================
REDIS_URL="redis://localhost:6379"

# ===========================================
# JWT Authentication
# ===========================================
# Generate with: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-long-change-in-production"
JWT_REFRESH_SECRET="your-super-secret-refresh-key-min-32-chars-long-change-in-production"

# ===========================================
# Cookies
# ===========================================
# Generate with: openssl rand -base64 32
COOKIE_SECRET="your-super-secret-cookie-key-min-32-chars-long-change-in-production"

# ===========================================
# CORS & URLs
# ===========================================
CORS_ORIGIN="http://localhost:5173"
API_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:5173"

# ===========================================
# WebAuthn / Passkeys
# ===========================================
WEB_AUTHN_RP_ID="localhost"
WEB_AUTHN_RP_NAME="OxeDinDin"
WEB_AUTHN_ORIGIN="http://localhost:5173"

# ===========================================
# Avatar upload
# ===========================================
# Directory where uploaded avatars are stored (must be writable by the backend).
UPLOAD_DIR="/tmp/oxedindin-uploads"
# Max avatar size in bytes (default 2 MB).
UPLOAD_MAX_SIZE="2097152"

# ===========================================
# Web Push (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
# ===========================================
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:noreply@oxedindin.com"

# ===========================================
# Email (Optional - for password reset, notifications)
# ===========================================
EMAIL_HOST="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="user@example.com"
EMAIL_PASS="password"
EMAIL_FROM="noreply@oxedindin.com"